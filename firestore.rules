rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Unique Username Handle Lock Registry
    // Anyone can read handles to check availability;
    // Only authenticated users can atomically reserve a non-existent handle for their own UID.
    // Handles cannot be updated or deleted (immutable lock).
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update, delete: if false;
    }

    // 2. User Profiles
    // Public profile details are readable (ratings, username, avatar);
    // Writes are strictly restricted to the user who owns the document.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Personal Spaced Repetition Drill Progress subcollection
      match /puzzle_progress/{puzzleId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Personal Positional Archive (Struggling positions & custom lines)
      match /saved_positions/{positionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
